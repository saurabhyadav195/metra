# Auto-detect text files and normalize line endings
* text=auto

# Force LF for Python files
*.py text eol=lf

# Common config and code files (always LF)
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.env text eol=lf

# Keep binary files untouched
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.pdf binary
*.zip binary
*.exe binary

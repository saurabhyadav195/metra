{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "verbatimModuleSyntax": false,

    "skipLibCheck": true,
    "noEmit": true,

    "jsx": "react-jsx",

    "types": ["vite/client"],

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src"]
}